<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<AnchorPane fx:id="rootPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #E6E6FA;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.studentattendance.controllers.RemoveStudentController">
    <children>
        <Label alignment="CENTER" layoutX="174.0" layoutY="57.0" text="Remove Student" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="50.0">
            <font>
                <Font name="Times New Roman Bold Italic" size="36.0" />
            </font>
        </Label>
        <GridPane alignment="CENTER" layoutX="160.0" layoutY="144.0" prefHeight="127.0" prefWidth="280.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="120.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="135.20001220703125" minWidth="10.0" prefWidth="125.5999755859375" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="154.4000244140625" minWidth="10.0" prefWidth="154.4000244140625" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Student Name: ">
                    <font>
                        <Font name="Times New Roman Bold" size="18.0" />
                    </font>
                </Label>
                <TextField fx:id="studentNameOrID" promptText="Enter Student name or id" GridPane.columnIndex="1">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
                    <effect>
                        <DropShadow>
                            <color>
                                <Color red="0.5058823823928833" green="0.49803921580314636" blue="0.49803921580314636" />
                            </color>
                        </DropShadow>
                    </effect></TextField>
                <Button mnemonicParsing="false" onAction="#onRemove" prefHeight="33.0" prefWidth="86.0" text="Remove" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <font>
                        <Font name="Times New Roman Bold" size="18.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                    <effect>
                        <DropShadow>
                            <color>
                                <Color red="0.5058823823928833" green="0.49803921580314636" blue="0.49803921580314636" />
                            </color>
                        </DropShadow>
                    </effect>
                </Button>
                <Button mnemonicParsing="false" onAction="#onBack" prefHeight="33.0" prefWidth="86.0" text="Back" GridPane.rowIndex="1">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                    <effect>
                        <DropShadow>
                            <color>
                                <Color red="0.5058823823928833" green="0.49803921580314636" blue="0.49803921580314636" />
                            </color>
                        </DropShadow>
                    </effect>
                </Button>
            </children>
        </GridPane>
    </children>
</AnchorPane>
